# AI Configuration for Book Publish Forge

# Choose AI Backend: 'ollama' (local) or 'openai' (cloud)
REACT_APP_AI_BACKEND=ollama

# ===== OLLAMA CONFIGURATION (Local, Privacy-First) =====
# Ollama runs on your machine - content never leaves your computer
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Start: ollama serve (runs automatically on install)
REACT_APP_OLLAMA_URL=http://127.0.0.1:11434
REACT_APP_OLLAMA_MODEL=dolphin-mixtral

# Recommended Ollama models for book writing:
# - dolphin-mixtral (best for creative writing, uncensored)
# - llama3 (fast, good quality)
# - mistral (balanced performance)
# - mixtral (advanced reasoning)
# 
# Install with: ollama pull dolphin-mixtral

# ===== OPENAI CONFIGURATION (Cloud, Requires API Key) =====
# Get API key from: https://platform.openai.com/api-keys
# Note: Content is sent to OpenAI servers
REACT_APP_OPENAI_KEY=
REACT_APP_OPENAI_MODEL=gpt-4

# ===== CUSTOM API ENDPOINT =====
# For enterprise or custom deployments
REACT_APP_CUSTOM_AI_URL=

# ===== IMAGE GENERATION (Optional) =====
# For cover art generation (like desktop app)
REACT_APP_IMAGE_URL=http://127.0.0.1:7860
