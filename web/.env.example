# Book Publish Forge web: local-only Ollama configuration.
# No cloud API keys: REACT_APP_ variables are embedded in browser builds.
REACT_APP_AI_BACKEND=ollama
REACT_APP_OLLAMA_URL=http://127.0.0.1:11434
REACT_APP_OLLAMA_MODEL=qwen3:8b

# Optional local cover-art endpoint; currently independent of the Ollama text API.
REACT_APP_IMAGE_URL=http://127.0.0.1:7860
